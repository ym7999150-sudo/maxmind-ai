# --- Required (generated automatically by `npm run setup`) ---
# 32 random bytes, base64. Encrypts provider API keys at rest (AES-256-GCM). LOSING IT MAKES SAVED KEYS UNRECOVERABLE.
ENCRYPTION_KEY=
# >= 32 chars. Used to HMAC session tokens.
AUTH_SECRET=

# --- Optional ---
PORT=3000
NODE_ENV=development
DATABASE_URL=file:./data/maxmind.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10
SESSION_HOURS=168
HEALTH_TTL_MINUTES=30
HEALTHCHECK_MAX_MODELS=40
# Set to 1 only behind HTTPS in non-production, or leave empty (defaults to 1 when NODE_ENV=production)
COOKIE_SECURE=
# Development only: enables a clearly-labelled MOCK provider (never allowed when NODE_ENV=production)
DEV_MOCK=0
# Development/tests only: allow http://localhost provider endpoints (e.g. a local OpenAI-compatible server)
ALLOW_INSECURE_LOCAL=0
